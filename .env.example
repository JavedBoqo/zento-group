# Existing website configuration
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RESEND_API_KEY=
MAIL_FROM=
MAIL_TO=

# Admin panel (server-only)
MONGODB_URI=mongodb://127.0.0.1:27017/zento
# Optional: only set if the system DNS resolver cannot resolve MongoDB SRV records.
MONGODB_DNS_SERVERS=
SESSION_SECRET=
# Development origin; production must use https://zentogroup.co.uk.
# When omitted, production defaults to Zento's public HTTPS origin.
APP_URL=http://localhost:3000

# Switch only after npm run migrate:content succeeds.
CONTENT_SOURCE=json

# true only behind a trusted proxy that overwrites x-forwarded-for.
# false applies shared rate limits to all visitors.
TRUST_PROXY=false

# Set temporarily for npm run admin:create, then remove.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Cloudinary (server-only; never prefix these with NEXT_PUBLIC_)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
