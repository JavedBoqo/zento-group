{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "minLength": 1,
      "$ref": "#/$defs/__schema0"
    },
    "slug": {
      "type": "string",
      "maxLength": 180,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "minLength": 1,
      "$ref": "#/$defs/__schema0"
    },
    "location": {
      "minLength": 1,
      "$ref": "#/$defs/__schema0"
    },
    "region": {
      "$ref": "#/$defs/__schema0"
    },
    "salary": {
      "$ref": "#/$defs/__schema0"
    },
    "salaryMin": {
      "type": "number",
      "minimum": 0
    },
    "salaryMax": {
      "type": "number",
      "minimum": 0
    },
    "contractTypes": {
      "$ref": "#/$defs/__schema1"
    },
    "office": {
      "$ref": "#/$defs/__schema0"
    },
    "phone": {
      "$ref": "#/$defs/__schema0"
    },
    "phoneHref": {
      "type": "string",
      "pattern": "^tel:[+\\d\\s()-]+$"
    },
    "email": {
      "type": "string",
      "format": "email",
      "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
    },
    "image": {
      "type": "string",
      "maxLength": 2000
    },
    "referralBonus": {
      "$ref": "#/$defs/__schema0"
    },
    "highlights": {
      "$ref": "#/$defs/__schema1"
    },
    "overview": {
      "$ref": "#/$defs/__schema2"
    },
    "responsibilities": {
      "$ref": "#/$defs/__schema1"
    },
    "whatWeOffer": {
      "$ref": "#/$defs/__schema1"
    },
    "requirements": {
      "$ref": "#/$defs/__schema1"
    },
    "isOpen": {
      "default": true,
      "type": "boolean"
    }
  },
  "required": [
    "id",
    "slug",
    "title",
    "location",
    "region",
    "salary",
    "salaryMin",
    "salaryMax",
    "contractTypes",
    "office",
    "phone",
    "phoneHref",
    "email",
    "image",
    "referralBonus",
    "highlights",
    "overview",
    "responsibilities",
    "whatWeOffer",
    "requirements"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "maxLength": 300
    },
    "__schema1": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema2"
      }
    },
    "__schema2": {
      "type": "string",
      "maxLength": 20000
    }
  }
}
